# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.astro/
.vercel/
.output/

# environment — never commit real credentials
.env
.env.*
!.env.example

# .cursor/mcp.json is committed — it holds only ${env:...} placeholders, never
# literal keys. scripts/check-mcp-safety.mjs and the pre-commit hook enforce
# that. See ADR-0014.

# reference material: predecessor-stack checkouts consulted during development.
# never committed — they carry third-party content and live credentials.
example-only/

# testing
test-results/
playwright-report/
playwright/.cache/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor and OS
.DS_Store
.idea/
*.swp
