HOST=localhost
PORT=4321

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# "server" (default) — on-demand rendering with CDN caching and tag invalidation.
# "static"           — fully prerendered at build time; content changes need a rebuild.
RENDER_MODE=server

# ---------------------------------------------------------------------------
# Orbitype CMS
# ---------------------------------------------------------------------------
# Truthy serves built-in seed content and makes no network calls.
# Leave true until you have a connector key, so the first `pnpm dev` works.
ORBITYPE_MOCK=true

ORBITYPE_API_SQL_URL=https://core.orbitype.com/api/sql/v1
ORBITYPE_API_SQL_KEY=

# ---------------------------------------------------------------------------
# Cache invalidation
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate. Unset disables the endpoint entirely
# (it returns 404), so an unconfigured deployment exposes nothing.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (contact form)
# ---------------------------------------------------------------------------
# No provider ships with the template. Implement EmailProvider in
# src/lib/email.ts, then fill these in.
MAIL_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_TO_EMAIL=

# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
# These four are required — the build fails without them.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=My Site
PUBLIC_SITE_DESCRIPTION=Describe this site in one sentence.
PUBLIC_ORGANIZATION_NAME=My Organisation

PUBLIC_ORGANIZATION_LOGO=/favicon.svg
PUBLIC_OG_LOGO_PATH=/favicon.svg
PUBLIC_OG_IMAGE_ENABLED=true
PUBLIC_COMMENTS_ENABLED=false

# Empty disables all GTM injection. No third-party script is loaded.
PUBLIC_GTM_ID=
PUBLIC_TWITTER_SITE=
PUBLIC_TWITTER_CREATOR=

# ---------------------------------------------------------------------------
# Editor tooling — NOT read by the app
# ---------------------------------------------------------------------------
# Cursor MCP reads ${env:...} from your shell environment, not from this file.
# Run `pnpm run mcp:env` to print the export lines for your shell profile.
#
#   ORBITYPE_SQL_API_KEY="your-sql-connector-key"
#   ORBITYPE_S3_PUBLIC_API_KEY="your-public-s3-key"
#   ORBITYPE_S3_PRIVATE_API_KEY="your-private-s3-key"
