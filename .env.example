HOST=localhost
PORT=4321

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# "server" (default) — on-demand rendering with CDN caching and tag invalidation.
# "static"           — pages prerendered at build time; /api/** remain serverless.
RENDER_MODE=server

# ---------------------------------------------------------------------------
# Orbitype runtime — deployed server
# ---------------------------------------------------------------------------
# Truthy serves built-in seed content and makes no network calls.
ORBITYPE_MOCK=true

ORBITYPE_API_SQL_URL=https://core.orbitype.com/api/sql/v1
ORBITYPE_API_SQL_KEY=

# ---------------------------------------------------------------------------
# Orbitype authoring tools — local only, never deploy
# ---------------------------------------------------------------------------
# Alias used by editor tooling and local CMS skills.
ORBITYPE_SQL_API_KEY=
ORBITYPE_S3_PUBLIC_API_KEY=
ORBITYPE_S3_PRIVATE_API_KEY=

# Optional allowlists (scripts may enforce when set)
# ORBITYPE_EXPECTED_PROJECT_ID=
# ORBITYPE_EXPECTED_CONNECTOR_ID=

# ---------------------------------------------------------------------------
# Cache invalidation
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (contact form)
# ---------------------------------------------------------------------------
MAIL_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_TO_EMAIL=

# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=My Site
PUBLIC_SITE_DESCRIPTION=Describe this site in one sentence.
PUBLIC_ORGANIZATION_NAME=My Organisation

PUBLIC_ORGANIZATION_LOGO=/favicon.svg
PUBLIC_OG_LOGO_PATH=/favicon.svg
PUBLIC_OG_IMAGE_ENABLED=true
PUBLIC_COMMENTS_ENABLED=false

PUBLIC_GTM_ID=
PUBLIC_TWITTER_SITE=
PUBLIC_TWITTER_CREATOR=

# Force X-Robots-Tag: noindex,nofollow (also automatic on Vercel previews)
# NOINDEX=true

# ---------------------------------------------------------------------------
# Figma authoring tools — local development only
# ---------------------------------------------------------------------------
# Used by .agents/skills/*figma*/scripts and verification commands.
# These variables are NOT used by the Astro runtime.
# Do not add them to Vercel and never prefix them with PUBLIC_.
FIGMA_API_KEY=
FIGMA_FILE_KEY=
FIGMA_EXPECTED_FILE_NAME=
FIGMA_EXPECTED_ACCOUNT_EMAIL=
