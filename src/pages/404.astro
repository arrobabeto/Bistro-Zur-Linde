---
import Base from "~/layouts/Base.astro"
import { DEFAULT_LOCALE } from "~/config/locales"
import { phrases } from "~/lib/phrases"
import { translate } from "~/lib/i18n"
import { siteName } from "~/lib/site"

const locale = DEFAULT_LOCALE
const title = translate(phrases.page_not_found, locale)
---

<Base locale={locale}>
  <Fragment slot="head">
    <title>{title} · {siteName()}</title>
    <meta name="robots" content="noindex" />
  </Fragment>
  <main class="container-prose py-section text-center">
    <p
      class="text-brand-700 mb-3 text-xs font-semibold tracking-[0.18em] uppercase"
    >
      404
    </p>
    <h1 class="mb-4 text-4xl font-semibold tracking-tight">{title}</h1>
    <p class="mb-8 text-neutral-600">The page you requested does not exist.</p>
    <a
      href="/"
      class="bg-brand-900 inline-flex rounded-lg px-5 py-2.5 text-sm font-medium text-white"
    >
      {translate(phrases.homepage, locale)}
    </a>
  </main>
</Base>
