---
// SectionContactHero.astro
//
// Centred contact intro with a three-column address / hours strip (Figma Kontakt).
//
// CMS JSON:
// {
//   "title":       { "de": "Wir sind" },
//   "titleAccent": { "de": "für Sie da." },
//   "lead":        { "de": "…" },
//   "leftLabel":   { "de": "Adresse" },
//   "leftText":    { "de": "Bistro zur Linde\nUntere Hauptstrasse 15B" },
//   "middleLabel": { "de": "Öffnungszeiten" },
//   "middleText":  { "de": "Mo–Fr: …" },
//   "rightLabel":  { "de": "Küche" },
//   "rightText":   { "de": "Mo–Fr: …" },
//   "_orbi":       { "component": "SectionContactHero" }
// }
import CmsText from "~/components/common/CmsText.astro"
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  titleAccent?: I18nString
  lead?: I18nString
  leftLabel?: I18nString
  leftText?: I18nString
  middleLabel?: I18nString
  middleText?: I18nString
  rightLabel?: I18nString
  rightText?: I18nString
  locale: Locale
}

const {
  title,
  titleAccent,
  lead,
  leftLabel,
  leftText,
  middleLabel,
  middleText,
  rightLabel,
  rightText,
  locale,
} = Astro.props

const heading = translate(title, locale)
const accent = translate(titleAccent, locale)

const columns = [
  { label: translate(leftLabel, locale), text: translate(leftText, locale) },
  {
    label: translate(middleLabel, locale),
    text: translate(middleText, locale),
  },
  { label: translate(rightLabel, locale), text: translate(rightText, locale) },
].filter((column) => column.label || column.text)

const columnClass =
  "flex flex-col items-center gap-3 text-center sm:w-[17.5rem] sm:shrink-0"
const headingClass =
  "font-display text-brand-900 text-[1.625rem] leading-8 font-bold"
const bodyClass = "text-brand-900 text-base leading-6"
const dividerClass = "bg-brand-900/20 hidden h-40 w-px shrink-0 sm:block"
---

<section
  class="container-wide py-12 lg:pt-12 lg:pb-16"
  data-testid="section-contact-hero"
>
  <div
    class="mx-auto flex max-w-[900px] flex-col items-center gap-8 text-center lg:gap-10"
  >
    <div class="flex flex-col items-center gap-6 lg:gap-8">
      {
        heading && (
          <h1 class="font-display text-brand-900 text-[2.5rem] leading-tight font-medium lg:text-[5rem] lg:leading-[88px]">
            {heading}
            {accent && (
              <>
                {" "}
                <em class="italic">
                  <CmsText html={accent} />
                </em>
              </>
            )}
          </h1>
        )
      }
      <p
        class="text-brand-900 max-w-[896px] text-base leading-[1.5] lg:text-xl lg:leading-[1.5]"
      >
        <CmsText html={translate(lead, locale)} />
      </p>
    </div>

    {
      columns.length > 0 && (
        <div class="border-brand-900/20 w-full max-w-[900px] border-y py-6">
          <div class="flex flex-col items-stretch gap-8 sm:flex-row sm:items-center sm:justify-center sm:gap-12 lg:gap-16">
            {columns.map((column, index) => (
              <div class="flex flex-col items-stretch gap-8 sm:contents">
                {index > 0 && (
                  <>
                    <span class={dividerClass} aria-hidden="true" />
                    <span
                      class="bg-brand-900/20 block h-px w-full sm:hidden"
                      aria-hidden="true"
                    />
                  </>
                )}
                <div class={columnClass}>
                  {column.label && <h2 class={headingClass}>{column.label}</h2>}
                  {column.text && (
                    <p class={bodyClass}>
                      {column.text.split("\n").map((line) => (
                        <span class="block whitespace-nowrap">{line}</span>
                      ))}
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
