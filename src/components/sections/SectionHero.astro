---
// SectionHero.astro
//
// CMS JSON:
// {
//   "title":       { "de": "Ein Name mit Geschichte." },
//   "titleAccent": { "de": "Eine Küche mit Ruf." },
//   "lead":        { "de": "…" },
//   "ctaLabel":    { "de": "Tisch reservieren" },
//   "ctaHref":     "#reservieren",
//   "img":         "/images/hero.jpg",
//   "imgAlt":      { "de": "…" },
//   "_orbi":       { "component": "SectionHero" }
// }
import CmsText from "~/components/common/CmsText.astro"
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  titleAccent?: I18nString
  lead?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const { title, titleAccent, lead, ctaLabel, ctaHref, img, imgAlt, locale } =
  Astro.props

const heading = translate(title, locale)
const accent = translate(titleAccent, locale)
const cta = translate(ctaLabel, locale)
---

<section data-testid="section-hero">
  <div
    class="container-wide grid gap-[22px] pt-8 pb-[26px] lg:grid-cols-[794fr_547fr] lg:gap-16 lg:pt-12 lg:pb-16"
  >
    {
      heading && (
        <h1 class="font-display text-display-xl text-brand-900 font-light whitespace-pre-line">
          <CmsText html={heading} />
          {accent && (
            <>
              {" "}
              <em class="font-medium italic">
                <CmsText html={accent} />
              </em>
            </>
          )}
        </h1>
      )
    }

    <div class="flex flex-col items-start gap-8 lg:gap-8 lg:pt-16">
      <p class="body-copy max-w-[330px] lg:max-w-xl">
        <CmsText html={translate(lead, locale)} />
      </p>
      {
        cta && ctaHref && (
          <a href={ctaHref} class="btn btn-secondary">
            {cta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>

  {
    img && (
      <img
        src={img}
        alt={translate(imgAlt, locale)}
        class="h-[309px] w-full object-cover lg:h-[600px]"
        width="1024"
        height="406"
        loading="eager"
      />
    )
  }
</section>
