---
// SectionPageHero.astro
//
// Full-bleed opening hero for room pages. The site header overlays it, so
// `[...slug].astro` switches Navigation to its light variant when a page
// starts with this section.
//
// CMS JSON:
// {
//   "title":             { "de": "Gut essen und sich\neinfach" },
//   "titleAccent":       { "de": "wohlfühlen." },
//   "lead":              { "de": "…" },
//   "ctaLabel":          { "de": "Tisch reservieren" },
//   "ctaHref":           "/kontakt",
//   "ctaSecondaryLabel": { "de": "Speisekarte ansehen" },
//   "ctaSecondaryHref":  "#speisekarte",
//   "align":             "center",
//   "img":               "/images/bistro-hero.jpg",
//   "imgAlt":            { "de": "…" },
//   "_orbi":             { "component": "SectionPageHero" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  titleAccent?: I18nString
  lead?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  ctaSecondaryLabel?: I18nString
  ctaSecondaryHref?: string
  /** `start` = left-aligned compact hero (Sääli); default centres like Bistro. */
  align?: "center" | "start"
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const {
  title,
  titleAccent,
  lead,
  ctaLabel,
  ctaHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  align = "center",
  img,
  imgAlt,
  locale,
} = Astro.props

const heading = translate(title, locale)
const accent = translate(titleAccent, locale)
const cta = translate(ctaLabel, locale)
const ctaSecondary = translate(ctaSecondaryLabel, locale)
const inset = align === "start"
---

<section
  class:list={[
    "relative isolate mb-12 flex overflow-hidden pt-24 pb-16 lg:mb-[62px] lg:pt-32",
    inset
      ? "min-h-[420px] items-end lg:min-h-[567px] lg:items-center lg:pb-16"
      : "min-h-[520px] items-center justify-center lg:min-h-[792px]",
  ]}
  data-testid="section-page-hero"
>
  {
    img && (
      <img
        src={img}
        alt={translate(imgAlt, locale)}
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        width="1512"
        height={inset ? 567 : 792}
        loading="eager"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-black/40"></div>

  <div
    class:list={[
      "flex flex-col gap-8 lg:gap-[45px]",
      inset
        ? "w-full items-start px-6 text-left md:px-10 lg:px-[120px]"
        : "container-wide items-center text-center",
    ]}
  >
    <div
      class:list={[
        "flex flex-col gap-4 lg:gap-[10px]",
        inset ? "items-start" : "items-center",
      ]}
    >
      {
        heading && (
          <h1
            class:list={[
              "font-display text-display-xl text-brand-50 font-medium lg:leading-[93px] lg:whitespace-pre-line",
              inset ? "max-w-[831px]" : "max-w-[620px]",
            ]}
          >
            {heading}
            {accent && (
              <>
                {" "}
                <em class="font-semibold italic">{accent}</em>
              </>
            )}
          </h1>
        )
      }

      <p
        class:list={[
          "text-brand-50 text-base leading-[1.67] lg:text-lg",
          inset ? "max-w-[631px]" : "max-w-[710px]",
        ]}
      >
        {translate(lead, locale)}
      </p>
    </div>

    <div
      class:list={[
        "flex flex-col gap-4 sm:flex-row lg:gap-8",
        inset ? "items-start" : "items-center",
      ]}
    >
      {
        cta && ctaHref && (
          <a href={ctaHref} class="btn btn-primary">
            {cta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
      {
        ctaSecondary && ctaSecondaryHref && (
          <a href={ctaSecondaryHref} class="btn btn-outline-light">
            {ctaSecondary}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</section>
