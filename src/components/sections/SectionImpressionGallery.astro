---
// SectionImpressionGallery.astro
//
// Asymmetric photo group plus a static video stand-in (Figma 2373:1468).
// Captions show below `lg`, matching the mobile frame.
//
// CMS JSON:
// {
//   "title": { "de": "Eindrücke von Anlässen" },
//   "lead": { "de": "…" },
//   "images": [{ "img": "…", "caption": { "de": "…" } }],
//   "videoTitle": { "de": "Ein Anlass in bewegten Bildern" },
//   "videoLabel": { "de": "Videoplatzhalter" },
//   "_orbi": { "component": "SectionImpressionGallery" }
// }
import CmsText from "~/components/common/CmsText.astro"
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Shot {
  img?: string
  imgAlt?: I18nString
  caption?: I18nString
}

interface Props {
  title?: I18nString
  lead?: I18nString
  images?: Shot[]
  videoTitle?: I18nString
  videoLabel?: I18nString
  locale: Locale
}

const { title, lead, images = [], videoTitle, videoLabel, locale } = Astro.props
const [leadShot, sideShot, detailShot] = images
const videoHeading = translate(videoTitle, locale)
const videoNote = translate(videoLabel, locale)

const frame = "w-full rounded-2xl object-cover"
---

<section
  class="bg-white px-6 py-16 lg:px-[120px] lg:py-[120px]"
  data-testid="section-impression-gallery"
>
  <div class="mx-auto flex max-w-[1272px] flex-col gap-8 lg:gap-12">
    <div class="flex flex-col gap-4">
      {
        translate(title, locale) && (
          <h2 class="font-display text-brand-900 text-[2rem] leading-[1.12] font-medium lg:text-[3.25rem]">
            <CmsText html={translate(title, locale)} />
          </h2>
        )
      }
      {
        translate(lead, locale) && (
          <p class="text-brand-500 text-base leading-6 lg:text-xl lg:leading-[30px]">
            <CmsText html={translate(lead, locale)} />
          </p>
        )
      }
    </div>

    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-6">
      <div
        class="contents lg:flex lg:w-[58.4%] lg:shrink-0 lg:flex-col lg:gap-6"
      >
        {
          leadShot?.img && (
            <figure class="order-1 flex flex-col gap-3">
              <img
                src={leadShot.img}
                alt={translate(leadShot.imgAlt, locale)}
                class:list={[frame, "h-[290px] lg:h-[400px]"]}
                width="744"
                height="400"
                loading="lazy"
              />
              {translate(leadShot.caption, locale) && (
                <figcaption class="text-brand-500 text-xs leading-5 lg:hidden">
                  {translate(leadShot.caption, locale)}
                </figcaption>
              )}
            </figure>
          )
        }
        {
          (videoHeading || videoNote) && (
            <div class="bg-brand-900 order-4 flex h-[230px] flex-col items-center justify-center gap-5 rounded-2xl px-6 text-center lg:h-[260px]">
              <span
                class="border-brand-50 flex size-16 items-center justify-center rounded-full border"
                aria-hidden="true"
              >
                <svg class="text-brand-50 size-[22px]" viewBox="0 0 22 22">
                  <path d="M8 5.5v11l9-5.5-9-5.5z" fill="currentColor" />
                </svg>
              </span>
              {videoHeading && (
                <p class="font-display text-brand-50 text-2xl leading-normal">
                  {videoHeading}
                </p>
              )}
              {videoNote && (
                <p class="text-brand-50 text-xs tracking-[0.1em] uppercase">
                  {videoNote}
                </p>
              )}
            </div>
          )
        }
      </div>
      <div class="contents lg:flex lg:min-w-0 lg:flex-1 lg:flex-col lg:gap-6">
        {
          sideShot?.img && (
            <figure class="order-2 flex flex-col gap-3">
              <img
                src={sideShot.img}
                alt={translate(sideShot.imgAlt, locale)}
                class:list={[frame, "h-[220px] lg:h-[260px]"]}
                width="480"
                height="260"
                loading="lazy"
              />
              {translate(sideShot.caption, locale) && (
                <figcaption class="text-brand-500 text-xs leading-5 lg:hidden">
                  {translate(sideShot.caption, locale)}
                </figcaption>
              )}
            </figure>
          )
        }
        {
          detailShot?.img && (
            <figure class="order-3 flex flex-col gap-3">
              <img
                src={detailShot.img}
                alt={translate(detailShot.imgAlt, locale)}
                class:list={[frame, "h-[280px] lg:h-[395px]"]}
                width="480"
                height="395"
                loading="lazy"
              />
              {translate(detailShot.caption, locale) && (
                <figcaption class="text-brand-500 text-xs leading-5 lg:hidden">
                  {translate(detailShot.caption, locale)}
                </figcaption>
              )}
            </figure>
          )
        }
      </div>
    </div>
  </div>
</section>
