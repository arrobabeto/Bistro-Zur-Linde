---
// SectionChefProfile.astro
//
// CMS JSON:
// {
//   "eyebrow":  { "de": "Küchenchef" },
//   "title":    { "de": "…" },
//   "text":     { "de": "…" },
//   "stats":    [{ "label": { "de": "14 GaultMillau Punkte" } }],
//   "ctaLabel": { "de": "Mehr über Ruedi Zünd" },
//   "ctaHref":  "/kontakt",
//   "img":      "/images/chef.jpg",
//   "imgAlt":   { "de": "…" },
//   "_orbi":    { "component": "SectionChefProfile" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Stat {
  label?: I18nString
}

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  text?: I18nString
  stats?: Stat[]
  ctaLabel?: I18nString
  ctaHref?: string
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const {
  eyebrow,
  title,
  text,
  stats = [],
  ctaLabel,
  ctaHref,
  img,
  imgAlt,
  locale,
} = Astro.props

const cta = translate(ctaLabel, locale)
const ctaExternal = Boolean(ctaHref?.startsWith("http"))
---

<section class="container-wide py-section">
  <div class="grid items-center gap-10 lg:grid-cols-[432px_1fr] lg:gap-24">
    {
      img && (
        <img
          src={img}
          alt={translate(imgAlt, locale)}
          class="order-last mx-auto aspect-[327/547] w-full max-w-[327px] rounded-[12rem] object-cover lg:order-first lg:aspect-auto lg:h-[720px] lg:max-w-none lg:rounded-[16rem]"
          width="432"
          height="720"
          loading="lazy"
        />
      )
    }

    <div
      class="flex flex-col items-center gap-6 text-center lg:items-start lg:text-left"
    >
      <p class="eyebrow">{translate(eyebrow, locale)}</p>
      <h2 class="section-title max-w-2xl text-balance">
        {translate(title, locale)}
      </h2>
      <p class="body-copy max-w-2xl">{translate(text, locale)}</p>

      {
        stats.length > 0 && (
          <ul class="mt-4 flex flex-col items-center gap-6 sm:grid sm:grid-cols-3 sm:gap-8 lg:items-stretch">
            {stats.map((stat) => (
              <li class="text-brand-900 text-base leading-6 tracking-[0.15em] whitespace-pre-line uppercase">
                {translate(stat.label, locale)}
              </li>
            ))}
          </ul>
        )
      }

      {
        cta && ctaHref && (
          <a
            href={ctaHref}
            class="btn btn-secondary mt-4 self-center lg:self-start"
            {...(ctaExternal
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {cta}
          </a>
        )
      }
    </div>
  </div>
</section>
