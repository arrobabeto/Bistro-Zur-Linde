---
// SectionChefProfile.astro
//
// CMS JSON:
// {
//   "eyebrow":  { "de": "Küchenchef" },
//   "title":    { "de": "…" },
//   "text":     { "de": "…" },
//   "stats":    [{ "label": { "de": "13 GaultMillau Punkte" } }],
//   "ctaLabel": { "de": "Mehr über Ruedi Zünd" },
//   "ctaHref":  "/kontakt",
//   "img":      "/images/chef.jpg",
//   "imgAlt":   { "de": "…" },
//   "_orbi":    { "component": "SectionChefProfile" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Stat {
  label?: I18nString
}

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  text?: I18nString
  stats?: Stat[]
  ctaLabel?: I18nString
  ctaHref?: string
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const {
  eyebrow,
  title,
  text,
  stats = [],
  ctaLabel,
  ctaHref,
  img,
  imgAlt,
  locale,
} = Astro.props

const cta = translate(ctaLabel, locale)
---

<section class="container-wide py-section">
  <div class="grid items-center gap-12 lg:grid-cols-[432px_1fr] lg:gap-24">
    {
      img && (
        <img
          src={img}
          alt={translate(imgAlt, locale)}
          class="h-[720px] w-full rounded-[16rem] object-cover"
          width="432"
          height="720"
          loading="lazy"
        />
      )
    }

    <div class="flex flex-col gap-6">
      <p class="eyebrow">{translate(eyebrow, locale)}</p>
      <h2 class="section-title max-w-2xl text-balance">
        {translate(title, locale)}
      </h2>
      <p class="body-copy max-w-2xl">{translate(text, locale)}</p>

      {
        stats.length > 0 && (
          <ul class="mt-4 grid gap-8 sm:grid-cols-3">
            {stats.map((stat) => (
              <li class="text-brand-900 text-base leading-6 tracking-[0.15em] whitespace-pre-line uppercase">
                {translate(stat.label, locale)}
              </li>
            ))}
          </ul>
        )
      }

      {
        cta && ctaHref && (
          <a href={ctaHref} class="btn btn-secondary mt-4 self-start">
            {cta}
          </a>
        )
      }
    </div>
  </div>
</section>
