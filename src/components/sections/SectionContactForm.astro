---
// SectionContactForm.astro
//
// Underline-style contact form (Figma Kontakt "Schreiben Sie uns").
// Posts to /api/forms/contact — Name/Vorname map to last_name/first_name;
// Ansprache → salutation (Frau/Herr); Betreff → topic.
//
// CMS JSON:
// {
//   "title":       { "de": "Schreiben Sie uns" },
//   "submitLabel": { "de": "Nachricht senden" },
//   "privacyLabel":{ "de": "Ich akzeptiere die" },
//   "privacyHref": "/datenschutz",
//   "_orbi":       { "component": "SectionContactForm" }
// }
import type { Locale } from "~/config/locales"
import { translate } from "~/lib/i18n"
import { phrases } from "~/lib/phrases"
import type { I18nString } from "~/types/i18n"
import { isEmailConfigured } from "~/lib/email"

interface Props {
  title?: I18nString
  submitLabel?: I18nString
  privacyLabel?: I18nString
  privacyHref?: string
  enabled?: boolean
  locale: Locale
}

const {
  title,
  submitLabel,
  privacyLabel,
  privacyHref = "/datenschutz",
  enabled,
  locale,
} = Astro.props

const heading = translate(title, locale)
const mailReady = enabled ?? isEmailConfigured()
const sent = Astro.url.searchParams.get("sent") === "1"
const errored = Astro.url.searchParams.get("error") === "1"
const field =
  "text-brand-900 min-h-11 w-full border-0 border-b border-brand-900/40 bg-transparent px-0 pb-3 text-base leading-[1.5] outline-none transition-colors focus:border-brand-900"
---

<section
  id="schreiben"
  class="container-inset scroll-mt-24 py-12 lg:py-[70px]"
  data-testid="section-contact-form"
>
  <div
    class="mx-auto flex max-w-[1008px] flex-col items-center gap-10 lg:gap-12"
  >
    {
      heading && (
        <h2 class="font-display text-brand-900 text-center text-[2rem] leading-tight font-semibold lg:text-[2.5rem] lg:leading-[72px]">
          {heading}
        </h2>
      )
    }

    {
      sent && (
        <p
          class="border-brand-900/20 bg-brand-50 text-brand-900 w-full border px-4 py-3 text-sm"
          role="status"
        >
          {translate(phrases.sent_successfully, locale)}
        </p>
      )
    }

    {
      errored && (
        <p
          class="border-accent-500/40 bg-brand-50 text-brand-900 w-full border px-4 py-3 text-sm"
          role="alert"
        >
          Die Nachricht konnte nicht gesendet werden. Bitte versuchen Sie es
          erneut.
        </p>
      )
    }

    {
      !mailReady && (
        <p class="border-accent-500/40 bg-brand-50 text-brand-900 w-full max-w-[1008px] border px-4 py-3 text-sm">
          Das Kontaktformular kann noch keine Nachrichten versenden — der
          E-Mail-Anbieter ist nicht konfiguriert.
        </p>
      )
    }

    <form
      method="post"
      action="/api/forms/contact"
      class="flex w-full flex-col gap-6"
      data-testid="contact-form"
    >
      <label class="relative flex flex-col gap-2">
        <span class="text-brand-900/70 text-base leading-[1.5]">Ansprache</span>
        <select
          required
          name="salutation"
          class={`${field} appearance-none pr-8`}
        >
          <option value=""></option>
          <option value="Frau">Frau</option>
          <option value="Herr">Herr</option>
        </select>
        <span
          class="text-brand-900 pointer-events-none absolute right-0 bottom-3"
          aria-hidden="true"
        >
          ⌄
        </span>
      </label>

      <div class="grid gap-6 sm:grid-cols-2 sm:gap-7">
        <label class="flex flex-col gap-2">
          <span class="text-brand-900/70 text-base leading-[1.5]">Name</span>
          <input
            required
            name="last_name"
            autocomplete="family-name"
            class={field}
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-brand-900/70 text-base leading-[1.5]">
            {translate(phrases.first_name, locale)}
          </span>
          <input
            required
            name="first_name"
            autocomplete="given-name"
            class={field}
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-brand-900/70 text-base leading-[1.5]">
            {translate(phrases.email, locale)}
          </span>
          <input
            required
            type="email"
            name="email"
            autocomplete="email"
            class={field}
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-brand-900/70 text-base leading-[1.5]">
            Telefonnummer
          </span>
          <input type="tel" name="phone" autocomplete="tel" class={field} />
        </label>
      </div>

      <label class="relative flex flex-col gap-2">
        <span class="text-brand-900/70 text-base leading-[1.5]">Betreff</span>
        <select name="topic" class={`${field} appearance-none pr-8`}>
          <option value=""></option>
          <option value="Anlass planen">Anlass planen</option>
          <option value="Gutschein kaufen">Gutschein kaufen</option>
          <option value="Sonstiges">Sonstiges</option>
        </select>
        <span
          class="text-brand-900 pointer-events-none absolute right-0 bottom-3"
          aria-hidden="true"
        >
          ⌄
        </span>
      </label>

      <label class="flex flex-col gap-2">
        <span class="text-brand-900/70 text-base leading-[1.5]">Nachricht</span>
        <textarea
          required
          name="message"
          rows="6"
          class={`${field} min-h-[180px] resize-y`}></textarea>
      </label>

      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>
          Website
          <input type="text" name="website" tabindex={-1} autocomplete="off" />
        </label>
      </div>

      <label class="text-brand-900/70 flex items-start gap-2 text-sm">
        <input
          required
          type="checkbox"
          name="privacy"
          value="on"
          class="mt-1"
        />
        <span>
          {translate(privacyLabel, locale) || "Ich akzeptiere die"}{" "}
          <a class="underline" href={privacyHref}>Datenschutzerklärung</a>.
        </span>
      </label>

      <div class="flex justify-center pt-2">
        <button type="submit" class="btn btn-secondary" disabled={!mailReady}>
          {translate(submitLabel, locale) || "Nachricht senden"}
        </button>
      </div>
    </form>
  </div>
</section>
