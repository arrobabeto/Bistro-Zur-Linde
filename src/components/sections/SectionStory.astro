---
// SectionStory.astro
//
// Editorial paragraph beside an arched photo (Figma "Story Section").
//
// CMS JSON:
// {
//   "title":         { "de": "Für jeden" },
//   "titleAccent":   { "de": "Tag" },
//   "text":          { "de": "…" },
//   "img":           "/images/bistro-story.jpg",
//   "imgAlt":        { "de": "…" },
//   "mediaPosition": "right",
//   "_orbi":         { "component": "SectionStory" }
// }
import CmsText from "~/components/common/CmsText.astro"
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  titleAccent?: I18nString
  text?: I18nString
  img?: string
  imgAlt?: I18nString
  mediaPosition?: "left" | "right"
  locale: Locale
}

const {
  title,
  titleAccent,
  text,
  img,
  imgAlt,
  mediaPosition = "right",
  locale,
} = Astro.props

const heading = translate(title, locale)
const accent = translate(titleAccent, locale)
---

<section class="container-inset py-12 lg:py-[62px]" data-testid="section-story">
  <div
    class="grid items-center gap-10 lg:grid-cols-[minmax(0,758px)_413px] lg:gap-[88px]"
  >
    <div
      class:list={[
        "flex flex-col items-center gap-8 text-center lg:items-start lg:gap-12 lg:pl-10 lg:text-left",
        mediaPosition === "left" && "lg:order-last lg:pr-10 lg:pl-0",
      ]}
    >
      {
        heading && (
          <h2
            class:list={[
              "font-display text-display-lg text-brand-900 font-semibold lg:leading-[72px]",
              !accent && "lg:max-w-[445px]",
            ]}
          >
            <CmsText html={heading} />
            {accent && (
              <>
                {" "}
                <em class="italic">
                  <CmsText html={accent} />
                </em>
              </>
            )}
          </h2>
        )
      }
      <p
        class="text-brand-900 max-w-[510px] text-base leading-[1.5] whitespace-pre-line lg:text-xl"
      >
        <CmsText html={translate(text, locale)} />
      </p>
    </div>

    {
      img && (
        <img
          src={img}
          alt={translate(imgAlt, locale)}
          class="mx-auto aspect-[327/547] w-full max-w-[327px] rounded-[12rem] object-cover lg:aspect-auto lg:h-[656px] lg:max-w-none lg:rounded-[18.75rem]"
          width="413"
          height="656"
          loading="lazy"
        />
      )
    }
  </div>
</section>
