---
import { knownSectionNames } from "~/lib/sections"
import type { Section } from "~/types/section"

interface Props {
  data: Section | Record<string, unknown>
}

const { data } = Astro.props
const componentName =
  data &&
  typeof data === "object" &&
  "_orbi" in data &&
  data._orbi &&
  typeof data._orbi === "object" &&
  "component" in data._orbi
    ? String((data._orbi as { component?: unknown }).component ?? "unknown")
    : "unknown"

const known = knownSectionNames()
let payload: string
try {
  payload = JSON.stringify(data, null, 2)
} catch {
  payload = "[unserializable]"
}
---

<aside
  class="border-brand-500/40 bg-brand-50 mx-auto my-8 max-w-3xl rounded-xl border-2 border-dashed p-6"
  role="status"
>
  <p
    class="text-brand-700 mb-2 text-xs font-semibold tracking-[0.15em] uppercase"
  >
    Debug
  </p>
  <h2 class="mb-2 text-lg font-semibold text-neutral-900">
    Missing section component
  </h2>
  <p class="mb-4 text-sm text-neutral-600">
    Requested <code class="bg-white px-1.5 py-0.5 font-mono text-sm"
      >{componentName}</code
    >
    — {Object.keys(data ?? {}).length} payload key(s).
  </p>

  <details class="mb-4">
    <summary class="cursor-pointer text-sm font-medium text-neutral-700"
      >Payload</summary
    >
    <pre
      class="mt-2 max-h-64 overflow-auto rounded-lg bg-neutral-900 p-4 text-xs text-neutral-100">{payload}</pre>
  </details>

  <p class="mb-2 text-sm font-medium text-neutral-700">Known sections</p>
  <ul class="flex flex-wrap gap-2">
    {
      known.map((name) => (
        <li class="rounded-md bg-white px-2 py-1 font-mono text-xs text-neutral-800 shadow-sm">
          {name}
        </li>
      ))
    }
  </ul>
</aside>
