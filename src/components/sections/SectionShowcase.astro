---
// SectionShowcase.astro
//
// Centred heading over a wide photo, with the caption and its call to action
// side by side underneath (Figma "Fine Dining Experience Section").
//
// CMS JSON:
// {
//   "eyebrow":  { "de": "Küchenchef" },
//   "title":    { "de": "Die Küche" },
//   "text":     { "de": "…" },
//   "ctaLabel": { "de": "Mehr über Ruedi Zünd" },
//   "ctaHref":  "/news",
//   "img":      "/images/bistro-kueche.jpg",
//   "imgAlt":   { "de": "…" },
//   "_orbi":    { "component": "SectionShowcase" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  text?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const { eyebrow, title, text, ctaLabel, ctaHref, img, imgAlt, locale } =
  Astro.props

const label = translate(eyebrow, locale)
const heading = translate(title, locale)
const cta = translate(ctaLabel, locale)
---

<section
  class="flex flex-col gap-10 pt-12 pb-12 lg:gap-14 lg:pt-[62px] lg:pb-[70px]"
  data-testid="section-showcase"
>
  <div class="container-inset flex flex-col items-center gap-4 text-center">
    {label && <p class="eyebrow">{label}</p>}
    {
      heading && (
        <h2 class="font-display text-display-lg text-brand-900 font-semibold lg:leading-[1.385]">
          {heading}
        </h2>
      )
    }
  </div>

  <div class="container-inset flex flex-col gap-8">
    {
      img && (
        <img
          src={img}
          alt={translate(imgAlt, locale)}
          class="h-[240px] w-full object-cover lg:h-[520px]"
          width="1280"
          height="520"
          loading="lazy"
        />
      )
    }

    <div
      class="flex flex-col items-center gap-6 text-center lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:text-left"
    >
      <p
        class="text-brand-900 max-w-[806px] text-base leading-[1.5] lg:text-xl"
      >
        {translate(text, locale)}
      </p>
      {
        cta && ctaHref && (
          <a href={ctaHref} class="btn btn-secondary shrink-0">
            {cta}
          </a>
        )
      }
    </div>
  </div>
</section>
