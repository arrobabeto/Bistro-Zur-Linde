---
// SectionEvents.astro
//
// CMS JSON:
// {
//   "eyebrow": { "de": "Events" },
//   "title":   { "de": "…" },
//   "items":   [{
//     "date":     { "de": "27- August -2026" },
//     "title":    { "de": "…" },
//     "text":     { "de": "…" },
//     "ctaLabel": { "de": "Mehr erfahren" },
//     "href":     "/news",
//     "img":      "/images/event-eroeffnung.jpg"
//   }],
//   "columns": 2,
//   "_orbi": { "component": "SectionEvents" }
// }
import { translate } from "~/lib/i18n"
import { phrases } from "~/lib/phrases"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface EventItem {
  date?: I18nString
  title?: I18nString
  text?: I18nString
  ctaLabel?: I18nString
  href?: string
  img?: string
  /** Shown from the `lg` breakpoint up; mobile keeps `img`. */
  imgDesktop?: string
  imgAlt?: I18nString
}

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  items?: EventItem[]
  /** Desktop column count. News uses 2; the homepage keeps the default 3. */
  columns?: 2 | 3
  locale: Locale
}

const { eyebrow, title, items = [], columns = 3, locale } = Astro.props
const eyebrowText = translate(eyebrow, locale)
const twoCol = columns === 2
const enlargeLabel = translate(phrases.enlarge_image, locale)
const closeLabel = translate(phrases.close, locale)
---

<section
  class:list={["py-section", twoCol ? "container-inset" : "container-wide"]}
  data-testid="section-events"
>
  <div
    class:list={[
      "mb-10 flex flex-col gap-4 lg:mb-12",
      twoCol && "lg:flex-row lg:items-end lg:justify-between",
    ]}
  >
    <div class="flex flex-col gap-4">
      {eyebrowText && <p class="eyebrow">{eyebrowText}</p>}
      <h2
        class:list={[
          "font-display text-brand-900 text-[2rem] leading-9 font-medium text-balance lg:text-[3rem]",
          twoCol
            ? "lg:max-w-[1033px] lg:leading-[72px]"
            : "max-w-5xl lg:leading-[1.15]",
        ]}
      >
        {translate(title, locale)}
      </h2>
    </div>

    {
      twoCol && (
        <div class="hidden gap-8 pb-2 lg:flex" aria-hidden="true">
          <span class="bg-brand-900 h-3 w-3 rounded-full" />
          <span class="bg-brand-900/25 h-3 w-3 rounded-full" />
          <span class="bg-brand-900/25 h-3 w-3 rounded-full" />
        </div>
      )
    }
  </div>

  <ul
    class:list={[
      "grid gap-10 md:grid-cols-2",
      twoCol
        ? "lg:mx-auto lg:max-w-[1280px] lg:grid-cols-2 lg:gap-x-10 lg:gap-y-12"
        : "lg:grid-cols-3 lg:gap-10",
    ]}
  >
    {
      items.map((item) => {
        const date = translate(item.date, locale)
        const cta = translate(item.ctaLabel, locale)
        const alt = translate(item.imgAlt, locale)
        return (
          <li class="flex flex-col">
            {item.img && (
              <button
                type="button"
                data-lightbox-trigger
                data-lightbox-alt={alt}
                aria-label={enlargeLabel}
                class="enter:opacity-90 cursor-zoom-in overflow-hidden text-left transition-opacity"
              >
                <picture>
                  {item.imgDesktop && (
                    <source
                      media="(min-width: 1024px)"
                      srcset={item.imgDesktop}
                    />
                  )}
                  <img
                    src={item.img}
                    alt={alt}
                    class="aspect-[323/480] w-full object-cover object-[center_top] lg:aspect-[620/480]"
                    width="620"
                    height="480"
                    loading="lazy"
                  />
                </picture>
              </button>
            )}

            <h3 class="font-display text-brand-900 mt-5 text-[2rem] leading-9 font-medium lg:leading-[1.3]">
              {translate(item.title, locale)}
            </h3>

            {twoCol ? (
              <>
                {date && (
                  <p class="text-brand-900 mt-2 text-sm leading-[1.64]">
                    {date}
                  </p>
                )}
                <span
                  class="bg-brand-900 mt-4 h-0.5 w-8 shrink-0"
                  aria-hidden="true"
                />
              </>
            ) : (
              <div class="mt-4 flex items-center gap-4">
                <span
                  class="bg-brand-900 h-0.5 w-8 shrink-0"
                  aria-hidden="true"
                />
                {date && (
                  <p class="text-brand-900 text-base leading-6 whitespace-nowrap">
                    {date}
                  </p>
                )}
              </div>
            )}

            <p class="text-brand-900 mt-5 text-base leading-6 lg:text-lg lg:leading-[1.5]">
              {translate(item.text, locale)}
            </p>

            {item.href && cta && (
              <a
                href={item.href}
                class="btn btn-secondary mt-6 self-start"
                {...(item.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {cta}
              </a>
            )}
          </li>
        )
      })
    }
  </ul>

  <dialog
    data-lightbox
    class="backdrop:bg-brand-900/80 m-auto max-h-[min(100vh-2rem,56rem)] w-[min(100%-2rem,72rem)] border-0 bg-transparent p-0 shadow-none"
    aria-label={enlargeLabel}
  >
    <div class="relative flex items-center justify-center p-2 sm:p-4">
      <button
        type="button"
        data-lightbox-close
        class="bg-brand-900/70 absolute top-3 right-3 z-10 flex h-10 w-10 items-center justify-center rounded-full text-2xl leading-none text-white"
        aria-label={closeLabel}
      >
        ×
      </button>
      <img
        data-lightbox-img
        src=""
        alt=""
        class="max-h-[min(90vh,52rem)] max-w-full object-contain"
      />
    </div>
  </dialog>
</section>

<script>
  import { initLightbox } from "~/scripts/lightbox"

  initLightbox()
</script>
