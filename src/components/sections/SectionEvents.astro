---
// SectionEvents.astro
//
// CMS JSON:
// {
//   "eyebrow": { "de": "Events" },
//   "title":   { "de": "…" },
//   "items":   [{
//     "date":     { "de": "03 FEB 2027" },
//     "title":    { "de": "…" },
//     "text":     { "de": "…" },
//     "ctaLabel": { "de": "Mehr erfahren" },
//     "href":     "/news",
//     "img":      "/images/event-eroeffnung.jpg"
//   }],
//   "_orbi": { "component": "SectionEvents" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface EventItem {
  date?: I18nString
  title?: I18nString
  text?: I18nString
  ctaLabel?: I18nString
  href?: string
  img?: string
  imgAlt?: I18nString
}

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  items?: EventItem[]
  locale: Locale
}

const { eyebrow, title, items = [], locale } = Astro.props
---

<section class="container-wide py-section">
  <div class="mb-10 flex flex-col gap-4 lg:mb-12">
    <p class="eyebrow">{translate(eyebrow, locale)}</p>
    <h2
      class="font-display text-brand-900 max-w-5xl text-[2rem] leading-9 font-medium text-balance lg:text-[3rem] lg:leading-[1.15]"
    >
      {translate(title, locale)}
    </h2>
  </div>

  <ul class="grid gap-[52px] md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
    {
      items.map((item) => (
        <li class="flex flex-col">
          <div class="relative">
            {item.img && (
              <img
                src={item.img}
                alt={translate(item.imgAlt, locale)}
                class="aspect-[323/480] w-full object-cover lg:aspect-[620/480]"
                width="620"
                height="480"
                loading="lazy"
              />
            )}
            <p class="bg-brand-50 text-brand-900 absolute top-5 right-5 px-5 py-3 text-base leading-6">
              {translate(item.date, locale)}
            </p>
          </div>

          <h3 class="font-display text-brand-900 mt-5 text-[2rem] leading-9 font-medium lg:mt-6 lg:text-[2.25rem] lg:leading-tight">
            {translate(item.title, locale)}
          </h3>

          <span class="bg-brand-900 mt-6 h-0.5 w-8" aria-hidden="true" />
          <p class="text-brand-900/80 mt-4 text-base leading-6 lg:text-lg">
            {translate(item.text, locale)}
          </p>

          {item.href && translate(item.ctaLabel, locale) && (
            <a href={item.href} class="btn btn-secondary mt-6 self-start">
              {translate(item.ctaLabel, locale)}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
