---
// SectionEvents.astro
//
// CMS JSON:
// {
//   "eyebrow": { "de": "Events" },
//   "title":   { "de": "…" },
//   "items":   [{
//     "date":     { "de": "03 FEB 2027" },
//     "title":    { "de": "…" },
//     "text":     { "de": "…" },
//     "ctaLabel": { "de": "Mehr erfahren" },
//     "href":     "/news",
//     "img":      "/images/event-eroeffnung.jpg"
//   }],
//   "columns": 2,
//   "_orbi": { "component": "SectionEvents" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface EventItem {
  date?: I18nString
  title?: I18nString
  text?: I18nString
  ctaLabel?: I18nString
  href?: string
  img?: string
  imgAlt?: I18nString
}

interface Props {
  eyebrow?: I18nString
  title?: I18nString
  items?: EventItem[]
  /** Desktop column count. News uses 2; the homepage keeps the default 3. */
  columns?: 2 | 3
  locale: Locale
}

const { eyebrow, title, items = [], columns = 3, locale } = Astro.props
const eyebrowText = translate(eyebrow, locale)
const twoCol = columns === 2
---

<section
  class:list={["py-section", twoCol ? "container-inset" : "container-wide"]}
  data-testid="section-events"
>
  <div
    class:list={[
      "mb-10 flex flex-col gap-4 lg:mb-12",
      twoCol && "lg:flex-row lg:items-end lg:justify-between",
    ]}
  >
    <div class="flex flex-col gap-4">
      {eyebrowText && <p class="eyebrow">{eyebrowText}</p>}
      <h2
        class:list={[
          "font-display text-brand-900 text-[2rem] leading-9 font-medium text-balance lg:text-[3rem]",
          twoCol
            ? "lg:max-w-[1033px] lg:leading-[72px]"
            : "max-w-5xl lg:leading-[1.15]",
        ]}
      >
        {translate(title, locale)}
      </h2>
    </div>

    {
      twoCol && (
        <div class="hidden gap-8 pb-2 lg:flex" aria-hidden="true">
          <span class="bg-brand-900 h-3 w-3 rounded-full" />
          <span class="bg-brand-900/25 h-3 w-3 rounded-full" />
          <span class="bg-brand-900/25 h-3 w-3 rounded-full" />
        </div>
      )
    }
  </div>

  <ul
    class:list={[
      "grid gap-10 md:grid-cols-2",
      twoCol
        ? "lg:mx-auto lg:max-w-[1280px] lg:grid-cols-2 lg:gap-x-10 lg:gap-y-12"
        : "lg:grid-cols-3 lg:gap-10",
    ]}
  >
    {
      items.map((item) => (
        <li class="flex flex-col">
          <div class="relative">
            {item.img && (
              <img
                src={item.img}
                alt={translate(item.imgAlt, locale)}
                class="aspect-[323/480] w-full object-cover lg:aspect-[620/480]"
                width="620"
                height="480"
                loading="lazy"
              />
            )}
            <p class="bg-brand-50 text-brand-900 absolute top-5 right-5 px-5 py-3 text-base leading-6">
              {translate(item.date, locale)}
            </p>
          </div>

          <h3 class="font-display text-brand-900 mt-5 text-[2rem] leading-9 font-medium lg:mt-5 lg:text-[2rem] lg:leading-[1.3]">
            {translate(item.title, locale)}
          </h3>

          <span class="bg-brand-900 mt-4 h-0.5 w-8" aria-hidden="true" />
          <p class="text-brand-900/80 mt-5 text-base leading-6 lg:text-lg lg:leading-[1.5]">
            {translate(item.text, locale)}
          </p>

          {item.href && translate(item.ctaLabel, locale) && (
            <a href={item.href} class="btn btn-secondary mt-6 self-start">
              {translate(item.ctaLabel, locale)}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
