---
// SectionLocationMap.astro
//
// Dark info strip with address / reachability, a route CTA, and a map
// (Figma Kontakt "Adresse & Erreichbarkeit"). Prefer `mapEmbedSrc` (Google
// Maps iframe); fall back to a static `img` if the embed is omitted.
//
// CMS JSON:
// {
//   "title":        { "de": "Adresse & Erreichbarkeit" },
//   "leftLabel":    { "de": "Adresse" },
//   "leftText":     { "de": "…" },
//   "rightLabel":   { "de": "Erreichbarkeit" },
//   "rightText":    { "de": "…" },
//   "ctaLabel":     { "de": "Route anzeigen" },
//   "ctaHref":      "https://maps.google.com/?q=…",
//   "mapEmbedSrc":  "https://www.google.com/maps/embed?pb=…",
//   "imgAlt":       { "de": "…" },
//   "_orbi":        { "component": "SectionLocationMap" }
// }
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  leftLabel?: I18nString
  leftText?: I18nString
  rightLabel?: I18nString
  rightText?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  mapEmbedSrc?: string
  img?: string
  imgAlt?: I18nString
  locale: Locale
}

const {
  title,
  leftLabel,
  leftText,
  rightLabel,
  rightText,
  ctaLabel,
  ctaHref,
  mapEmbedSrc,
  img,
  imgAlt,
  locale,
} = Astro.props

const heading = translate(title, locale)
const leftHeading = translate(leftLabel, locale)
const rightHeading = translate(rightLabel, locale)
const cta = translate(ctaLabel, locale)
const mapTitle = translate(imgAlt, locale)
---

<section
  class="bg-brand-500 px-6 py-12 md:px-10 lg:px-20 lg:py-[80px]"
  data-testid="section-location-map"
>
  <div
    class="mx-auto flex max-w-[1280px] flex-col items-center gap-10 lg:gap-12"
  >
    <div
      class="flex w-full max-w-[900px] flex-col items-center gap-8 text-center lg:gap-12"
    >
      {
        heading && (
          <h2 class="font-display text-brand-50 text-[2rem] leading-tight font-semibold lg:text-[3.25rem] lg:leading-[72px]">
            {heading}
          </h2>
        )
      }

      <div
        class="flex w-full flex-col items-stretch gap-8 sm:flex-row sm:items-center sm:justify-center sm:gap-16 lg:gap-24"
      >
        <div class="flex flex-1 flex-col items-center gap-3">
          {
            leftHeading && (
              <h3 class="font-display text-brand-50 text-[1.375rem] leading-8 font-bold lg:text-[1.625rem]">
                {leftHeading}
              </h3>
            )
          }
          <p
            class="text-brand-50 max-w-[252px] text-base leading-6 whitespace-pre-line"
          >
            {translate(leftText, locale)}
          </p>
        </div>

        <span
          class="hidden h-40 w-px shrink-0 bg-white sm:block"
          aria-hidden="true"></span>

        <div class="flex flex-1 flex-col items-center gap-3">
          {
            rightHeading && (
              <h3 class="font-display text-brand-50 text-[1.375rem] leading-8 font-bold lg:text-[1.625rem]">
                {rightHeading}
              </h3>
            )
          }
          <p
            class="text-brand-50 max-w-[252px] text-base leading-6 whitespace-pre-line"
          >
            {translate(rightText, locale)}
          </p>
        </div>
      </div>

      {
        cta && ctaHref && (
          <a
            href={ctaHref}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            {cta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    {
      mapEmbedSrc ? (
        <iframe
          src={mapEmbedSrc}
          title={mapTitle || "Map"}
          class="h-[240px] w-full max-w-[1280px] border-0 lg:h-[522px]"
          width="1280"
          height="522"
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      ) : (
        img && (
          <img
            src={img}
            alt={mapTitle}
            class="h-[240px] w-full max-w-[1280px] object-cover lg:h-[522px]"
            width="1280"
            height="522"
            loading="lazy"
          />
        )
      )
    }
  </div>
</section>
