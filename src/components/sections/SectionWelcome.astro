---
// SectionWelcome.astro
//
// First-run onboarding, schema installer and seeder.
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Capability {
  title: I18nString
  text: I18nString
  badge?: string
}

interface Step {
  title: I18nString
  text: I18nString
  kind?: "wizard" | "seed"
  code?: string
}

interface Props {
  title?: I18nString
  lead?: I18nString
  capabilities?: Capability[]
  steps?: Step[]
  hasSqlKeyConfigured?: boolean
  apiKeysUrl?: string
  locale: Locale
}

const {
  title,
  lead,
  capabilities = [],
  steps = [],
  hasSqlKeyConfigured = false,
  apiKeysUrl = "https://app.orbitype.com/settings/api-keys",
  locale,
} = Astro.props

const heading = translate(title, locale)
---

<section class="container-wide py-section">
  <div class="mx-auto max-w-3xl">
    <p
      class="text-brand-700 mb-3 text-xs font-semibold tracking-[0.18em] uppercase"
    >
      Setup
    </p>
    {
      heading && (
        <h1 class="mb-4 text-4xl font-semibold tracking-tight text-balance">
          {heading}
        </h1>
      )
    }
    <p class="mb-10 text-lg text-neutral-600">
      {translate(lead, locale)}
    </p>
  </div>

  {
    capabilities.length > 0 && (
      <ul class="mb-14 grid gap-4 sm:grid-cols-3">
        {capabilities.map((cap) => (
          <li class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
            {cap.badge && (
              <span class="bg-brand-50 text-brand-700 mb-2 inline-block rounded-full px-2 py-0.5 text-xs font-medium">
                {cap.badge}
              </span>
            )}
            <h2 class="mb-2 text-base font-semibold text-neutral-900">
              {translate(cap.title, locale)}
            </h2>
            <p class="text-sm text-neutral-600">
              {translate(cap.text, locale)}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mx-auto max-w-3xl space-y-3">
    {
      steps.map((step, index) => (
        <details
          class="group rounded-xl border border-neutral-200 bg-white open:shadow-sm"
          open={index === 0}
        >
          <summary class="cursor-pointer list-none px-5 py-4 font-medium text-neutral-900">
            <span class="text-brand-700 mr-2 font-mono text-sm">
              {String(index + 1).padStart(2, "0")}
            </span>
            {translate(step.title, locale)}
          </summary>
          <div class="border-t border-neutral-100 px-5 py-4">
            <p class="mb-3 text-sm text-neutral-600">
              {translate(step.text, locale)}
            </p>

            {step.code && (
              <div class="relative mb-3">
                <pre class="overflow-x-auto rounded-lg bg-neutral-900 p-4 text-xs text-neutral-100">
                  <code data-copy-source>{step.code}</code>
                </pre>
                <button
                  type="button"
                  class="absolute top-2 right-2 rounded-md bg-white/10 px-2 py-1 text-xs text-white hover:bg-white/20"
                  data-copy-button
                >
                  Copy
                </button>
              </div>
            )}

            {step.kind === "wizard" && hasSqlKeyConfigured && (
              <div class="mt-4 space-y-3" data-install-wizard>
                <p class="text-sm text-neutral-500" data-install-message>
                  Start the wizard to install schema into your Orbitype
                  workspace.
                </p>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    class="bg-brand-900 rounded-lg px-4 py-2 text-sm font-medium text-white"
                    data-install-table="all"
                  >
                    Install all tables
                  </button>
                  <button
                    type="button"
                    class="rounded-lg border border-neutral-300 px-4 py-2 text-sm"
                    data-install-table="pages"
                  >
                    pages
                  </button>
                  <button
                    type="button"
                    class="rounded-lg border border-neutral-300 px-4 py-2 text-sm"
                    data-install-table="posts"
                  >
                    posts
                  </button>
                  <button
                    type="button"
                    class="rounded-lg border border-neutral-300 px-4 py-2 text-sm"
                    data-install-table="settings"
                  >
                    settings
                  </button>
                  <button
                    type="button"
                    class="rounded-lg border border-neutral-300 px-4 py-2 text-sm"
                    data-install-table="contacts"
                  >
                    contacts
                  </button>
                  <button
                    type="button"
                    class="rounded-lg border border-neutral-300 px-4 py-2 text-sm"
                    data-install-table="templates"
                  >
                    templates
                  </button>
                </div>
                <ul class="space-y-1 text-sm" data-install-results />
              </div>
            )}

            {step.kind === "wizard" && !hasSqlKeyConfigured && (
              <p class="mt-3 text-sm text-amber-700">
                Add a SQL API key to enable the installer.{" "}
                <a
                  class="text-brand-700 underline"
                  href={apiKeysUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open API keys
                </a>
              </p>
            )}

            {step.kind === "seed" && hasSqlKeyConfigured && (
              <div class="mt-4 space-y-3" data-seed-wizard>
                <p class="text-sm text-neutral-500" data-seed-message>
                  Seed the homepage into your Orbitype workspace.
                </p>
                <button
                  type="button"
                  class="bg-brand-900 rounded-lg px-4 py-2 text-sm font-medium text-white"
                  data-seed-button
                >
                  Seed starter content
                </button>
              </div>
            )}
          </div>
        </details>
      ))
    }
  </div>

  <p class="mt-10 text-center text-sm text-neutral-500">
    API keys:{" "}
    <a
      class="text-brand-700 underline"
      href={apiKeysUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {apiKeysUrl}
    </a>
  </p>
</section>

<script>
  function wireCopy() {
    for (const button of document.querySelectorAll("[data-copy-button]")) {
      button.addEventListener("click", async () => {
        const pre = button.closest("div")?.querySelector("[data-copy-source]")
        if (!pre) return
        try {
          await navigator.clipboard.writeText(pre.textContent ?? "")
          button.textContent = "Copied"
          setTimeout(() => {
            button.textContent = "Copy"
          }, 1500)
        } catch {
          button.textContent = "Select & copy"
        }
      })
    }
  }

  function wireInstall() {
    const root = document.querySelector("[data-install-wizard]")
    if (!root) return

    const message = root.querySelector("[data-install-message]")
    const results = root.querySelector("[data-install-results]")

    for (const button of root.querySelectorAll("[data-install-table]")) {
      button.addEventListener("click", async () => {
        const table = button.getAttribute("data-install-table") ?? "all"
        const first = window.confirm(
          `Prepare installation for ${table === "all" ? "all tables" : `${table} table`}?`,
        )
        if (!first) return
        const second = window.confirm(
          `Final confirmation: install ${table} in your Orbitype workspace now?`,
        )
        if (!second) return

        if (message) message.textContent = "Running schema installer..."
        if (results) results.innerHTML = ""

        try {
          const response = await fetch("/api/setup/install-schema", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table }),
          })
          const data = await response.json()
          if (message) message.textContent = data.message ?? "Done"
          if (results && Array.isArray(data.results)) {
            results.innerHTML = data.results
              .map(
                (r: { table: string; status: string; error?: string }) =>
                  `<li><strong>${r.table}</strong>: ${r.status}${r.error ? ` — ${r.error}` : ""}</li>`,
              )
              .join("")
          }
        } catch (error) {
          if (message)
            message.textContent =
              error instanceof Error ? error.message : "Install failed"
        }
      })
    }
  }

  function wireSeed() {
    const root = document.querySelector("[data-seed-wizard]")
    if (!root) return
    const message = root.querySelector("[data-seed-message]")
    const button = root.querySelector("[data-seed-button]")
    if (!button) return

    button.addEventListener("click", async () => {
      if (!window.confirm("Seed starter content into your Orbitype workspace?"))
        return
      if (message) message.textContent = "Seeding..."
      try {
        const response = await fetch("/api/setup/seed", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        })
        const data = await response.json()
        if (message) message.textContent = data.message ?? "Seeded"
      } catch (error) {
        if (message)
          message.textContent =
            error instanceof Error ? error.message : "Seed failed"
      }
    })
  }

  wireCopy()
  wireInstall()
  wireSeed()
</script>
