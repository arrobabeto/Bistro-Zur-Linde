---
// SectionSplitPanel.astro
//
// Edge-to-edge photo beside a dark panel carrying the copy (Figma 2033:712).
//
// CMS JSON:
// {
//   "title":         { "de": "Mittag- und\nAbendkarte" },
//   "text":          { "de": "…" },
//   "ctaLabel":      { "de": "Speisekarte entdecken" },
//   "ctaHref":       "/speisekarte",
//   "ctaSecondaryLabel": { "de": "Getränkekarte ansehen" },
//   "ctaSecondaryHref":  "/documents/menu-2026-09-02-77387eee.pdf",
//   "img":           "/images/bistro-menu.jpg",
//   "imgAlt":        { "de": "…" },
//   "mediaPosition": "left",
//   "panelTone":     "muted",
//   "anchor":        "speisekarte",
//   "_orbi":         { "component": "SectionSplitPanel" }
// }
import CmsText from "~/components/common/CmsText.astro"
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  text?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  ctaSecondaryLabel?: I18nString
  ctaSecondaryHref?: string
  img?: string
  imgAlt?: I18nString
  mediaPosition?: "left" | "right"
  /** `muted` = taupe panel (Sääli); default is the dark coffee panel. */
  panelTone?: "dark" | "muted"
  /** Makes the section a scroll target for links elsewhere on the page. */
  anchor?: string
  locale: Locale
}

const {
  title,
  text,
  ctaLabel,
  ctaHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  img,
  imgAlt,
  mediaPosition = "left",
  panelTone = "dark",
  anchor,
  locale,
} = Astro.props

const heading = translate(title, locale)
const body = translate(text, locale)
const cta = translate(ctaLabel, locale)
const ctaSecondary = translate(ctaSecondaryLabel, locale)
const showPrimary = Boolean(cta && ctaHref)
const showSecondary = Boolean(ctaSecondary && ctaSecondaryHref)
---

<section
  id={anchor}
  class="mt-12 grid scroll-mt-24 lg:mt-[70px] lg:grid-cols-2"
  data-testid="section-split-panel"
>
  {
    img && (
      <div
        class:list={[
          "relative h-[280px] overflow-hidden lg:h-auto lg:min-h-[529px]",
          mediaPosition === "right" && "lg:order-last",
        ]}
      >
        <img
          src={img}
          alt={translate(imgAlt, locale)}
          class="absolute inset-0 h-full w-full object-cover"
          width="764"
          height="529"
          loading="lazy"
        />
      </div>
    )
  }

  <div
    class:list={[
      "flex flex-col justify-center px-6 py-14 md:px-10 lg:px-[72px] lg:py-[91px]",
      panelTone === "muted" ? "bg-brand-500" : "bg-brand-900",
    ]}
  >
    <div class="flex flex-col gap-6">
      {
        (heading || body) && (
          <div class="flex max-w-[418px] flex-col gap-6">
            {heading && (
              <h2 class="font-display text-display-lg text-brand-50 font-medium lg:leading-[1.27] lg:whitespace-pre-line">
                <CmsText html={heading} />
              </h2>
            )}
            {body && (
              <p class="text-brand-50 text-base leading-[1.67] lg:text-lg">
                <CmsText html={body} />
              </p>
            )}
          </div>
        )
      }
      {
        (showPrimary || showSecondary) && (
          <div
            class:list={[
              "mt-2",
              showPrimary && showSecondary
                ? "flex flex-col gap-3 sm:flex-row sm:items-stretch"
                : "flex flex-row flex-wrap items-center gap-3",
            ]}
          >
            {showPrimary && (
              <a
                href={ctaHref}
                class:list={[
                  "btn btn-primary shrink-0 justify-center !px-6 !py-3 whitespace-nowrap lg:!px-8",
                  showSecondary && "min-h-[3.5rem] w-full sm:w-auto sm:flex-1",
                ]}
              >
                {cta}
                <span aria-hidden="true">→</span>
              </a>
            )}
            {showSecondary && (
              <a
                href={ctaSecondaryHref}
                class:list={[
                  "btn shrink-0 justify-center !px-6 !py-3 whitespace-nowrap lg:!px-8",
                  showPrimary && "min-h-[3.5rem] w-full sm:w-auto sm:flex-1",
                  panelTone === "muted" ? "btn-outline-light" : "btn-primary",
                ]}
              >
                {ctaSecondary}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
