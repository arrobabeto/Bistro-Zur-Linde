---
// SectionPromoBanner.astro
//
// CMS JSON:
// {
//   "slides": [{
//     "img":     "/images/promo-1.jpg",
//     "imgAlt":  { "de": "…" },
//     "eyebrow": { "de": "Der Ort" },
//     "title":   { "de": "Neubau, Terrasse, Umgebung — einzigartig in der Region" },
//     "href":    "/bistro"
//   }],
//   "_orbi": { "component": "SectionPromoBanner" }
// }
import { translate } from "~/lib/i18n"
import { phrases } from "~/lib/phrases"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Slide {
  img?: string
  imgAlt?: I18nString
  eyebrow?: I18nString
  title?: I18nString
  href?: string
}

interface Props {
  slides?: Slide[]
  locale: Locale
}

const { slides = [], locale } = Astro.props
// Slide anchors must be unique if the section ever appears twice on a page.
const id = `promo-${crypto.randomUUID().slice(0, 8)}`
---

<section data-carousel class="container-wide py-section">
  <div class="flex items-center gap-4">
    <button
      type="button"
      data-carousel-prev
      class="carousel-arrow"
      aria-label={translate(phrases.previous, locale)}
    >
      <span aria-hidden="true">&#8592;</span>
    </button>

    <ul
      data-carousel-track
      class="flex flex-1 snap-x snap-mandatory gap-10 overflow-x-auto scroll-smooth"
    >
      {
        slides.map((slide, index) => (
          <li
            id={`${id}-${index}`}
            class="relative w-full shrink-0 snap-center overflow-hidden"
          >
            {slide.img && (
              <img
                src={slide.img}
                alt={translate(slide.imgAlt, locale)}
                class="h-[670px] w-full object-cover"
                width="1280"
                height="670"
                loading="lazy"
              />
            )}

            {translate(slide.title, locale) && (
              <div class="bg-brand-50 absolute top-10 left-10 max-w-2xl px-8 py-7">
                <p class="eyebrow text-accent-300">
                  {translate(slide.eyebrow, locale)}
                </p>
                <h2 class="font-display text-brand-900 mt-2 text-[3rem] leading-[1.02] font-medium text-balance">
                  {slide.href ? (
                    <a href={slide.href}>{translate(slide.title, locale)}</a>
                  ) : (
                    translate(slide.title, locale)
                  )}
                </h2>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-carousel-next
      class="carousel-arrow"
      aria-label={translate(phrases.next, locale)}
    >
      <span aria-hidden="true">&#8594;</span>
    </button>
  </div>

  <ol class="mt-8 flex justify-center gap-4">
    {
      slides.map((_, index) => (
        <li>
          <a
            data-carousel-dot
            href={`#${id}-${index}`}
            class="carousel-dot"
            aria-current={index === 0 ? "true" : "false"}
          >
            <span class="sr-only">{index + 1}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { initCarousels } from "~/scripts/carousel"

  initCarousels()
</script>
