---
import { phrases } from "~/lib/phrases"
import { translate } from "~/lib/i18n"
import type { Locale } from "~/config/locales"
import { siteName } from "~/lib/site"
import {
  CONTACT_ADDRESS,
  FOOTER_LEGAL,
  FOOTER_ROOMS,
  FOOTER_SERVICE,
  SOCIAL_LINKS,
} from "~/config/navigation"
import SocialIcon from "~/components/common/SocialIcon.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const year = new Date().getFullYear()

const columns = [
  { key: "rooms", items: FOOTER_ROOMS },
  { key: "service", items: FOOTER_SERVICE },
  { key: "legal", items: FOOTER_LEGAL },
]
---

<footer class="bg-brand-900 mt-auto text-white">
  <div
    class="container-wide grid justify-items-center gap-12 py-14 text-center lg:grid-cols-2 lg:justify-items-stretch lg:py-20 lg:text-left"
  >
    <div class="flex flex-col items-center gap-8 lg:items-start">
      <a href="/">
        <img
          src="/images/logo-light.svg"
          alt={siteName()}
          class="h-[86px] w-[86px]"
          width="86"
          height="86"
        />
      </a>

      <ul class="flex items-center gap-3">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                class="enter:border-white flex h-10 w-10 items-center justify-center rounded-full border border-white/40 transition-colors"
                aria-label={social.label}
                rel="noopener noreferrer"
                target="_blank"
              >
                <SocialIcon name={social.label} />
              </a>
            </li>
          ))
        }
      </ul>

      <address class="text-xl leading-7 not-italic">
        {CONTACT_ADDRESS.map((line) => <span class="block">{line}</span>)}
      </address>

      <p class="text-lg leading-7">© {year}</p>
    </div>

    <div
      class="flex flex-col items-center gap-10 sm:grid sm:grid-cols-3 sm:items-start lg:justify-items-start"
    >
      {
        columns.map((column) => (
          <nav aria-label={translate(phrases.menu, locale)}>
            <ul class="flex flex-col items-center gap-6 lg:items-start">
              {column.items.map((item) => (
                <li>
                  <a class="footer-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
</footer>
