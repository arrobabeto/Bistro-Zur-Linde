---
import { phrases } from "~/lib/phrases"
import { translate } from "~/lib/i18n"
import type { Locale } from "~/config/locales"
import { siteName } from "~/lib/site"
import {
  CONTACT_ADDRESS,
  CONTACT_COMPANY,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  FOOTER_LEGAL,
  FOOTER_MENU,
  OPENING_HOURS,
  KITCHEN_HOURS,
  SOCIAL_LINKS,
} from "~/config/navigation"
import SocialIcon from "~/components/common/SocialIcon.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const year = new Date().getFullYear()
---

<footer class="mt-auto bg-[#7C695C] text-white">
  <div
    class="container-wide grid gap-12 py-14 text-center lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:items-start lg:justify-items-stretch lg:gap-16 lg:py-[5.8rem] lg:text-left"
  >
    <div class="flex flex-col items-center gap-8 lg:items-start">
      <a href="/" class="shrink-0">
        <img
          src="/images/logo-footer.png"
          alt={siteName()}
          class="h-[118px] w-auto"
          width="92"
          height="118"
        />
      </a>

      <ul class="flex items-center gap-6">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                class="enter:opacity-70 flex h-10 w-10 items-center justify-center text-white transition-opacity"
                aria-label={social.label}
                rel="noopener noreferrer"
                target="_blank"
              >
                <SocialIcon name={social.label} />
              </a>
            </li>
          ))
        }
      </ul>

      <address class="leading-7 not-italic">
        <span class="block text-[22px]">{CONTACT_COMPANY}</span>
        {
          CONTACT_ADDRESS.map((line) => (
            <span class="block text-xl">{line}</span>
          ))
        }
      </address>

      <p class="text-lg leading-7">© {year}</p>
    </div>

    <div class="flex flex-col gap-12 lg:gap-14">
      <div
        class="grid justify-items-center gap-10 sm:grid-cols-3 sm:items-start sm:justify-items-start lg:gap-8"
      >
        <nav aria-label={translate(phrases.menu, locale)}>
          <ul class="flex flex-col items-center gap-6 lg:items-start">
            {
              FOOTER_MENU.map((item) => (
                <li>
                  <a class="footer-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex flex-col items-center gap-8 lg:items-start">
          <div class="flex flex-col items-center gap-4 lg:items-start">
            <h2 class="font-display text-2xl leading-7 font-semibold">
              Öffnungszeiten
            </h2>
            <p class="text-xl leading-7 font-light whitespace-pre-line">
              {OPENING_HOURS.join("\n")}
            </p>
          </div>
          <div class="flex flex-col items-center gap-4 lg:items-start">
            <h2 class="font-display text-2xl leading-7 font-semibold">Küche</h2>
            <p class="text-xl leading-7 font-light whitespace-pre-line">
              {KITCHEN_HOURS.join("\n")}
            </p>
          </div>
        </div>

        <nav aria-label="Rechtliches">
          <h2 class="font-display mb-4 text-2xl leading-7 font-medium">
            Rechtliches
          </h2>
          <ul class="flex flex-col items-center gap-6 lg:items-start">
            {
              FOOTER_LEGAL.map((item) => (
                <li>
                  <a class="footer-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div
        class="grid justify-items-center gap-10 sm:grid-cols-2 sm:items-end sm:justify-items-start lg:gap-8"
      >
        <div class="flex flex-col items-center gap-4 lg:items-start">
          <h2
            class="font-display border-brand-50/80 border-b pb-2 text-2xl leading-7 font-semibold"
          >
            Kontakt
          </h2>
          <a
            class="footer-link"
            href={`tel:${CONTACT_PHONE.replace(/\s/g, "")}`}
          >
            {CONTACT_PHONE}
          </a>
          <a class="footer-link" href={`mailto:${CONTACT_EMAIL}`}>
            {CONTACT_EMAIL}
          </a>
        </div>

        <div
          id="newsletter"
          class="flex w-full max-w-[541px] flex-col items-center gap-4 lg:items-start"
        >
          <h2
            class="font-display text-center text-[1.75rem] leading-8 font-normal lg:text-left"
          >
            Abonnieren Sie unseren Newsletter
          </h2>
          <p class="text-center text-base leading-8 font-light lg:text-left">
            Exklusive Neuigkeiten, Angebote und Rezepte direkt per E-Mail
            erhalten.
          </p>
          <a
            class="btn btn-primary mt-2 min-w-[234px]"
            href="https://www.opentable.de/widget/comms/mural?rid=514932&lang=de-DE"
            rel="noopener noreferrer"
            target="_blank"
          >
            Jetzt anmelden
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
