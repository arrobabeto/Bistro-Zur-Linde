---
import { phrases } from "~/lib/phrases"
import { translate } from "~/lib/i18n"
import type { Locale } from "~/config/locales"
import { siteName } from "~/lib/site"
import { PRIMARY_NAV, RESERVATION_HREF } from "~/config/navigation"

interface Props {
  locale: Locale
  /** Lay the header over a full-bleed hero instead of stacking above it. */
  overlay?: boolean
}

const { locale, overlay = false } = Astro.props
---

<header class:list={[overlay ? "absolute inset-x-0 top-0 z-20" : "relative"]}>
  <nav
    class="container-wide flex items-center gap-3 py-6 lg:gap-6"
    aria-label={translate(phrases.menu, locale)}
  >
    <a href="/" class="shrink-0">
      <img
        src={overlay ? "/images/logo-light.svg" : "/images/logo.svg"}
        alt={siteName()}
        class="h-12 w-12 lg:h-[86px] lg:w-[86px]"
        width="86"
        height="86"
      />
    </a>

    <ul class="ml-8 hidden flex-wrap items-center gap-8 lg:flex">
      {
        PRIMARY_NAV.map((item) => (
          <li>
            <a
              class:list={[
                "nav-link",
                overlay && "enter:!text-white/70 !text-white",
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      class="btn btn-primary ml-auto shrink-0 !px-7 !py-1 text-sm leading-6 lg:!px-14 lg:!py-3 lg:text-lg lg:leading-8"
      href={RESERVATION_HREF}
    >
      {translate(phrases.reserve_now, locale)}
    </a>

    {
      /* Native disclosure: the zero-client-JS e2e guard forbids a scripted menu */
    }
    <details class="group shrink-0 lg:hidden">
      <summary
        class="flex h-[30.5px] w-[30.5px] cursor-pointer list-none items-center justify-center [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">{translate(phrases.menu, locale)}</span>
        <svg
          class:list={[
            "h-[30.5px] w-[30.5px] group-open:hidden",
            overlay ? "text-white" : "text-brand-900",
          ]}
          viewBox="0 0 30.502 30.502"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8.855 15.251h12.546M8.855 10.823h12.546M8.855 19.679h12.546"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle
            cx="15.251"
            cy="15.251"
            r="15.001"
            stroke="currentColor"
            stroke-width="0.5"></circle>
        </svg>
        <svg
          class:list={[
            "hidden h-[30.5px] w-[30.5px] group-open:block",
            overlay ? "text-white" : "text-brand-900",
          ]}
          viewBox="0 0 30.502 30.502"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10 10l10.5 10.5M20.5 10L10 20.5"
            stroke="currentColor"
            stroke-linecap="round"></path>
          <circle
            cx="15.251"
            cy="15.251"
            r="15.001"
            stroke="currentColor"
            stroke-width="0.5"></circle>
        </svg>
      </summary>

      <ul
        class="border-brand-900/10 absolute inset-x-0 top-full z-30 flex flex-col border-t bg-white px-6 pb-6 shadow-lg"
      >
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a class="nav-link block py-3" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
