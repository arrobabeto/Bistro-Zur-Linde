{
  "mcpServers": {
    "orbitype-sql": {
      "url": "https://core.orbitype.com/api/mcp/v1",
      "headers": {
        "X-API-KEY": "${env:ORBITYPE_SQL_API_KEY}"
      }
    },
    "orbitype-s3-public": {
      "url": "https://core.orbitype.com/api/mcp/v1",
      "headers": {
        "X-API-KEY": "${env:ORBITYPE_S3_PUBLIC_API_KEY}"
      }
    },
    "orbitype-s3-private": {
      "url": "https://core.orbitype.com/api/mcp/v1",
      "headers": {
        "X-API-KEY": "${env:ORBITYPE_S3_PRIVATE_API_KEY}"
      }
    }
  }
}
